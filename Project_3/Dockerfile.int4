# Image cho ĐƯỜNG A — chỉ nén lm_head, KHÔNG cần vá vLLM.
#   sinh checkpoint: python3 tools/requant_int4_full.py --stage lmhead
#   mốc kích thước:  ~1.13 GB (từ 1.32 GB). Ra khác nhiều nghĩa là recipe không ăn.
#
# Đường B (nén cả conv proj, cần vá vLLM) dùng Dockerfile.convquant.
FROM vllm/vllm-openai:v0.22.1
COPY awq_model_int4_lmhead/ /model/
RUN python3 -c "import json; c=json.load(open('/model/config.json'))['quantization_config']; g=list(c['config_groups'].values())[0]['weights']; assert g.get('symmetric') == True, 'FAIL: checkpoint is asymmetric — requant with W4A16 symmetric'; assert g['num_bits'] == 4, 'FAIL: not 4-bit'"
